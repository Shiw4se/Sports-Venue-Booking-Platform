DATABASE_URL=postgres://postgres:postgres@localhost:5432/SportCourts
RABBITMQ_URL=amqp://localhost
RPC_QUEUE=payment_rpc_queue
BOOKING_RPC_QUEUE=booking_rpc_queue
USER_RPC_QUEUE=user_rpc_queue
EVENTS_QUEUE=payment_events
# Leave empty to disable online payments (bookings are confirmed immediately, as without Stripe)
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/payments/webhook` (whsec_...) or the Stripe Dashboard
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Where Stripe sends the player back after Checkout
APP_URL=http://localhost:3010
# Slot times shown on the Checkout page use this time zone
APP_TIMEZONE=Europe/Kyiv
# How long a slot is held while the player pays (Stripe's minimum is 30)
PAYMENT_HOLD_MINUTES=30
