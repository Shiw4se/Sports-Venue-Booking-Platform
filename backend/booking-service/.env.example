DATABASE_URL=postgres://postgres:postgres@localhost:5432/SportCourts
RABBITMQ_URL=amqp://localhost
RPC_QUEUE=booking_rpc_queue
VENUE_RPC_QUEUE=venue_rpc_queue
USER_RPC_QUEUE=user_rpc_queue
# How often to look for games starting within 24 hours (ms)
REMINDER_INTERVAL_MS=300000
# Delay before the first reminder run (lets notification-service create its queue on a fresh broker)
REMINDER_START_DELAY_MS=30000
PAYMENT_RPC_QUEUE=payment_rpc_queue
# Minutes a slot is held while the player pays
PAYMENT_HOLD_MINUTES=30
# How often expired holds are released (ms)
PAYMENT_SWEEP_INTERVAL_MS=60000
