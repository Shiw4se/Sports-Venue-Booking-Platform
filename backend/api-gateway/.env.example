PORT=3000
RABBITMQ_URL=amqp://localhost
USER_RPC_QUEUE=user_rpc_queue
VENUE_RPC_QUEUE=venue_rpc_queue
BOOKING_RPC_QUEUE=booking_rpc_queue
NOTIFICATION_RPC_QUEUE=notification_rpc_queue
RPC_TIMEOUT_MS=10000
# Must match JWT_SECRET in user-service
JWT_SECRET=change-me-to-a-long-random-string
# Max login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT=50
